body common control
{
  inputs => { "../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

bundle agent test
{
  meta:
    "test_soft_fail"
      string => "(solaris|aix|hpux|windows)",
      # ENT-6540 exotics fail to delete chroot
      # ENT-10254 tests fail on Windows due to CRLF
      meta => { "ENT-6540", "ENT-10254" };

    "description"
      string => "Test that --simulate=manifest shows a relative symlink target as written in the policy, not as an absolute path";
}

bundle agent check
{
  vars:
    "command"
      string => "$(sys.cf_agent) -Kf $(this.promise_filename).sub --simulate=manifest 2>&1";

    "wanted"
      string => ".*\Q'$(G.testroot)/relative-link' is a symbolic link\E\n(?:[^\n]*\n){0,7}\QTarget: 'relative-target'\E.*";

  methods:
    "check"
      usebundle => dcs_passif_output(
        $(wanted),
        ".*Target: '/.*",
        $(command),
        $(this.promise_filename)
      );
}
