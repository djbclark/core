body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

bundle common test_user
{
  classes:
    "running_as_root"
      expression => strcmp("$(sys.user_data[uid])", "0");
}

bundle agent test
{
  meta:
    "test_soft_fail"
      string => "(solaris|aix|hpux|windows)",
      # ENT-6540 exotics fail to delete chroot
      # ENT-10254 tests fail on Windows due to CRLF
      meta => { "ENT-6540", "ENT-10254" };

    "test_skip_unsupported"
      string => "!linux|!running_as_root|using_fakeroot",
      comment => "Needs root and a file system with the immutable flag";

    "description"
      string => "Test that --simulate=manifest as root still denies an owner change on an immutable file, as a real run does";
}

bundle agent check
{
  vars:
    "command"
      string => "$(sys.cf_agent) -Kf $(this.promise_filename).sub --simulate=manifest 2>&1; find $(sys.statedir) -name frozen -exec chattr -i {} + 2>&1; rm -rf $(sys.statedir)/*.changes",
      comment => "The simulated file is immutable in the chroot, which then can't be deleted, so clean up here";

    "output"
      string => execresult($(command), "useshell");

  classes:
    "denied"
      expression => regcmp(
        ".*error: Cannot set ownership on file '$(G.testroot)/frozen'.*",
        $(output));

    "not_changed"
      not => regcmp(
        ".*Owner of '$(G.testroot)/frozen' was .*",
        $(output));

    "ok" and => { "denied", "not_changed" };

  reports:
    ok::
      "$(this.promise_filename) Pass";

    !ok::
      "$(this.promise_filename) FAIL";
      "denied: $(denied) not_changed: $(not_changed)";
      "output: $(output)";
}
