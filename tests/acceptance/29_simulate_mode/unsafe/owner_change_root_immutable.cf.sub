body common control
{
  inputs => { "../../default.sub.cf" };
}

bundle agent main
{
  files:
    "$(G.testroot)/frozen"
      create => "true",
      fsattrs => freeze;

    "$(G.testroot)/frozen"
      perms => owner_nobody;
}

body fsattrs freeze
{
  immutable => "true";
}

body perms owner_nobody
{
  owners => { "nobody" };
}
