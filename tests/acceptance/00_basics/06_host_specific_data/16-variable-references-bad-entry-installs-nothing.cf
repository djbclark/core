# test that one entry with an unresolved variable reference makes the CMDB
# loader install nothing from host_specific.json: the file is all or nothing,
# so no entry can be left behind without the entry that was meant to guard it
body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

#######################################################
bundle agent init
{
  files:
    "$(sys.workdir)$(const.dirsep)data$(const.dirsep)."
      create => "true",
      perms => mog(
        "0700", "$(sys.user_data[username])", "$(sys.user_data[username])"
      );

  methods:
    "prepare_host_specific_data"
      usebundle => file_copy(
        "$(this.promise_filename).json",
        "$(sys.workdir)$(const.dirsep)data$(const.dirsep)host_specific.json"
      ),
      handle => "prepare_host_specific_data";

    "empty_promises_cf"
      usebundle => file_make("$(sys.inputdir)/promises.cf", '');
}

#######################################################
bundle agent check
{
  vars:
    "error_output"
      string => execresult(
        "$(sys.cf_promises) --show-classes -f $(sys.inputdir)/promises.cf",
        "useshell"
      ),
      depends_on => { "prepare_host_specific_data" };

    "vars_output"
      string => execresult(
        "$(sys.cf_promises) --show-vars -f $(sys.inputdir)/promises.cf | $(G.grep) good_key",
        "useshell"
      ),
      depends_on => { "prepare_host_specific_data" };

  classes:
    # The offending entry is rejected and named.
    "offender_named"
      expression => regcmp(
        ".*error: Invalid 'vars' CMDB data in '.*host_specific\.json', cannot contain variable references \(offending value in entry 'key_with_unresolved_value': .*",
        "$(error_output)"
      );

    # The loader says that it installed none of the file.
    "nothing_installed_reported"
      expression => regcmp(
        ".*error: CMDB data file '.*host_specific\.json' has invalid entries \(see above\), installing none of its contents.*",
        "$(error_output)"
      );

    # Its sibling entry in the same section is NOT installed: a single bad
    # entry takes the whole file down, so that policy never runs with only
    # part of the data it was written against.
    "good_entry_absent"
      not => regcmp(
        ".*good_key.*",
        "$(vars_output)"
      );

    "ok" and => { "offender_named", "nothing_installed_reported", "good_entry_absent" };

  reports:
    ok::
      "$(this.promise_filename) Pass";

    !ok::
      "$(this.promise_filename) FAIL";

    !ok.DEBUG::
      "error_output was: '$(error_output)'";
      "vars_output was: '$(vars_output)'";
}
