# test of the host_specific.json functionality: JSON null scalar values are
# rejected (used to crash), every one is reported, and since one invalid entry
# makes the loader install nothing, no entries from the file are installed
body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

#######################################################
bundle agent init
{
  files:
    "$(sys.workdir)$(const.dirsep)data$(const.dirsep)."
      create => "true",
      perms => mog(
        "0700", "$(sys.user_data[username])", "$(sys.user_data[username])"
      );

  methods:
    "prepare_host_specific_data"
      usebundle => file_copy(
        "$(this.promise_filename).json",
        "$(sys.workdir)$(const.dirsep)data$(const.dirsep)host_specific.json"
      ),
      handle => "prepare_host_specific_data";

    "empty_promises_cf"
      usebundle => file_make("$(sys.inputdir)/promises.cf", '');
}

#######################################################
bundle agent check
{
  vars:
    "command"
      string => "$(sys.cf_promises) --show-vars -f $(sys.inputdir)/promises.cf | $(G.grep) -E 'CMDB data|value_from_|null_'";

    # Only the scalar null entries are reported as errors (lists containing
    # null and containers with nested null stay valid), and the file is
    # rejected as a whole so nothing is installed.
    "expected"
      string => concat(
        "\s*error: Invalid value in 'null_scalar'.*null is not a supported value.*",
        "\s+error: Invalid value in 'null_value'.*null is not a supported value.*",
        "\s+error: Invalid value in 'null_bare'.*null is not a supported value.*",
        "\s+error: CMDB data file '.*host_specific\.json' has invalid entries.*installing none of its contents.*"
      );

  methods:
    ""
      usebundle => dcs_passif_output(
        $(expected),
        ".*(value_from_|data:variables\.null_|null_list|null_value_list).*",
        $(command),
        $(this.promise_filename)
      );
}
