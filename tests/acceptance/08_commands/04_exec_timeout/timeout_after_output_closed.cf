#######################################################
#
# exec_timeout must terminate a command that closed its output before
# exiting. The agent's read loop ends at EOF, so it is already waiting for
# the child when the alarm fires. Unfixed, the pid the alarm would signal had
# been cleared by then and the command ran to completion.
#
# The elapsed time is the difference between two marker files touched just
# before and after the timed promise. The sleep is long enough that the
# termination ladder, however slow the platform makes it, is still well
# under it.
#
#######################################################
body common control
{
  inputs => { "../../default.sub.cf" };
  bundlesequence => { default("$(this.promise_filename)") };
  version => "1.0";
}

#######################################################
bundle agent init
{
  files:
    "$(G.testdir)/oc_start" delete => tidy;
    "$(G.testdir)/oc_end" delete => tidy;
    "$(G.testdir)/oc_completed" delete => tidy;
}

#######################################################
bundle agent test
{
  meta:
    "description"
      string => "exec_timeout terminates a command that closed its output";

    "test_skip_unsupported"
      string => "windows",
      comment => "Runs a POSIX shell payload";

  commands:
    "/bin/sh" arglist => { "-c", "touch $(G.testdir)/oc_start" };

    "/bin/sh"
      arglist => {
        "-c", "exec 1>&- 2>&-; sleep 30; touch $(G.testdir)/oc_completed",
      },
      contain => exec_timeout_2;

    "/bin/sh" arglist => { "-c", "touch $(G.testdir)/oc_end" };
}

body contain exec_timeout_2
{
  exec_timeout => "2";
}

#######################################################
bundle agent check
{
  vars:
    "start" string => filestat("$(G.testdir)/oc_start", "mtime");
    "end" string => filestat("$(G.testdir)/oc_end", "mtime");
    "elapsed" string => eval("$(end) - $(start)", "math", "infix");

  classes:
    # A command that ran to completion reaches the marker after its sleep.
    "ok"
      and => {
        fileexists("$(G.testdir)/oc_start"),
        fileexists("$(G.testdir)/oc_end"),
        islessthan("$(elapsed)", "25"),
        not(fileexists("$(G.testdir)/oc_completed")),
      };

  methods:
    "any"
      usebundle => dcs_passif("ok", $(this.promise_filename)),
      inherit => "true";
}

